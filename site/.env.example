# Server Configuration
HOST=
PORT=
NODE_ENV=

# Base URL
BASE_URL=

# Analytics
GTM_ID=
PIXEL_ID=

# API URLs - Server-side (used in API routes and server components)
PROD_API_URL=
DEV_API_URL=

# API URLs - Client-side (used in browser, must start with NEXT_PUBLIC_)
NEXT_PUBLIC_PROD_API_URL=
NEXT_PUBLIC_DEV_API_URL=
NEXT_PUBLIC_API_URL=

# Environment detection for client-side
NEXT_PUBLIC_NODE_ENV=

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=

# Analitika (client-side) — boş qalarsa heç nə yüklənmir
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PIXEL_ID=
# Kanonik sayt ünvanı (sitemap, canonical, JSON-LD üçün)
NEXT_PUBLIC_SITE_URL=https://elcar.az
