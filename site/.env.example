# API URLs - Client-side (used in browser, must start with NEXT_PUBLIC_)
NEXT_PUBLIC_PROD_API_URL=
NEXT_PUBLIC_DEV_API_URL=
NEXT_PUBLIC_API_URL=

# Environment detection for client-side
NEXT_PUBLIC_NODE_ENV=

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=
